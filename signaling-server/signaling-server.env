# Server env
BIND_ADDR=127.0.0.1:9009 # What ip and port are you using, example 127.0.0.1:9000 for local port (inside docker image this won't work), or 0.0.0.0:9000 for global mapping
DEDICATED_RELAY_ADDR=127.0.0.1:8811 # If using another docker image as relay server, use name of docker image. Otherwise input proper IP address
RATE_LIMIT=10 # How many messages are allowed in a given window
RATE_LIMIT_WINDOW_SEC=1 # How many seconds is the rate limit window
CLEANUP_INTERVAL=3 # How many minutes between each cleanup task is run
CLIENT_TIMEOUT_SEC=300 # How many seconds without a heartbeat from a client until its marked as unreachable and removed from the list of connected clients 
SESSION_TIMEOUT_SEC=600 # How many seconds without a heartbeat for a session to be cleared from the list
DEFAULT_MAX_CLIENTS_IN_SESSION=10 # What will be the default max clients in a session.